# Names match src/finance_analysis/settings.py.
# What each one does: docs/en/settings.md and docs/ru/settings.md.
# A line that starts with # is not applied. cp .env.example .env keeps those off.
# FAS_HOST_PORT and BUILDER_HOST_PORT are Compose shell variables. This file does not set them.

# Required. Database 1. The process refuses to start without it.
FAS_REDIS_URL=redis://127.0.0.1:6379/1
# Directory for local storage. Default ./data.
FAS_DATA_DIR=./data
# Host bind for uv run fas-api. Default 127.0.0.1. Compose sets 0.0.0.0 inside the container.
FAS_HOST=127.0.0.1
# Port for uv run fas-api. Default 8080.
FAS_PORT=8080
# Builder HTTP API. Empty means builder calls fail immediately.
BUILDER_BASE_URL=http://127.0.0.1:8080

# false: run fas-worker and fas-scheduler yourself. Compose sets true.
# FAS_EMBEDDED_WORKERS=false
# Seconds to wait before restarting a dead embedded child. Default 1.
# FAS_EMBEDDED_RESTART_BACKOFF_SEC=1
# Empty allows glossary writes. A value requires the x-admin-token header.
# FAS_ADMIN_TOKEN=
# true rejects store writes.
# FAS_READ_ONLY=false
# Directory of eval labels, under labels/. Default eval.
# FAS_EVAL_DIR=eval
# Book lock lifetime, milliseconds. Default 60000.
# LOCK_TTL_MS=60000
# Seconds POST /v1/books/{job_id}:load may wait. Default 20.
# LOAD_SYNC_SEC=20
# Findings cache lifetime, seconds. Default 300.
# ETAG_TTL=300

# Local MinIO. Uncomment together. The region matches the Compose MinIO.
# Leave FAS_S3_SSL unset outside this block: it follows the endpoint.
# Code default for the region is us-east-1.
# FAS_S3_ENDPOINT=http://127.0.0.1:9000
# FAS_S3_BUCKET=finance-context
# Key prefix. Default fas. On disk this is a directory under FAS_DATA_DIR.
# FAS_S3_PREFIX=fas
# FAS_S3_ACCESS_KEY=minioadmin
# FAS_S3_SECRET_KEY=minioadmin
# FAS_S3_REGION=ap-northeast-1
# FAS_S3_SSL=false

# A model stage stays off until both its URL and its model name are set.
# EMBED_BASE_URL=
# EMBED_MODEL=
# Embed call timeout, seconds. Default 2.
# EMBED_TIMEOUT_SEC=2
# Parallel embed calls. Default 16.
# EMBED_MAX_CONCURRENCY=16
# RERANK_BASE_URL=
# RERANK_MODEL=
# cohere or tei. Default cohere.
# RERANK_DIALECT=cohere
# Rerank call timeout, seconds. Default 3.
# RERANK_TIMEOUT_SEC=3
# Parallel rerank calls. Default 8.
# RERANK_MAX_CONCURRENCY=8
# CLM_BASE_URL=
# CLM_MODEL=
# Sent as Authorization: Bearer when set.
# CLM_API_KEY=
# CLM call timeout, seconds. Default 10.
# CLM_TIMEOUT_SEC=10
# Parallel CLM calls. Default 4.
# CLM_MAX_CONCURRENCY=4
# CLM choices per book. 0 disables those calls. Default 50.
# CLM_MAX_CALLS_PER_BOOK=50
# LLM_BASE_URL=
# LLM_MODEL=
# Sent as Authorization: Bearer when set.
# LLM_API_KEY=
# LLM call timeout, seconds. Default 30.
# LLM_TIMEOUT_SEC=30
# Parallel LLM calls. Default 4.
# LLM_MAX_CONCURRENCY=4
# Model circuit-breaker window, seconds. Default 30.
# CB_WINDOW_SEC=30
# Model retries allowed per minute. Default 60.
# RETRY_BUDGET_PER_MIN=60
# Mapping pipeline deadline, milliseconds. Default 60000.
# MAPPING_DEADLINE_MS=60000
# Concepts kept from the embedding search. Default 20.
# RECALL_TOP_K=20
# Candidates kept after rerank. Default 5.
# RERANK_TOP_K=5
# Candidates shown on one mapping question. Default 5.
# QUESTION_MAX_CANDIDATES=5
# Nearest labeled examples. Default 5.
# KNN_K=5
# How often the example index reloads, seconds. Default 60.
# EXAMPLES_REFRESH_SEC=60

# Process-wide engine cap. Default 32. The memory cap below can lower it.
# WREN_ENGINE_POOL=32
# Memory budget for all engines, megabytes. Default 8192.
# WREN_POOL_MEMORY_MB=8192
# DuckDB memory_limit per engine, megabytes. Must be > 0. Default 512.
# WREN_DUCKDB_MEMORY_MB=512
# DuckDB threads per engine. Must be > 0. Default 2.
# WREN_DUCKDB_THREADS=2
# Waiters one engine accepts before another is considered. Default 8.
# WREN_ENGINE_QUEUE_MAX=8
# Waiters on the first engine before a second engine for that book may start. Default 3.
# WREN_HOT_QUEUE=3
# Engines one book may hold. Default 2.
# WREN_ENGINES_PER_BOOK=2
# The process does not read this value. Default 600.
# WREN_ENGINE_IDLE_SEC=600
# Thread pool for Wren calls. Default 8.
# WREN_THREADS=8
# Thread pool for CPU work. Default 8.
# CPU_THREADS=8

# In-flight HTTP handlers before 503. Default 64.
# API_MAX_INFLIGHT=64
# Synchronous request deadline, milliseconds. Default 10000.
# SYNC_DEADLINE_MS=10000
# Impact and ratios go async above this many periods. Default 120.
# SYNC_MAX_PERIODS=120
# Cap on the operation wait query, milliseconds. Default 30000.
# OPERATION_WAIT_MAX_MS=30000
# false makes GET /v1/operations/{id}/events answer 404. Default true.
# SSE_ENABLED=true
# Seconds between SSE heartbeats. Default 15.
# SSE_HEARTBEAT_SEC=15
# The process does not read this value. Default 100.
# ASYNC_SLOW_CALLBACK_MS=100
# The process does not read this value. Default 86400.
# RESULT_CACHE_TTL=86400
# Stored idempotency record lifetime, seconds. Default 86400.
# IDEMPOTENCY_TTL=86400
# Per-user requests per second. Default 10.
# RATE_USER_RPS=10
# Per-user burst. Default 20.
# RATE_USER_BURST=20
# Per-client requests per second. Default 50.
# RATE_CLIENT_RPS=50
# Per-client burst. Default 100.
# RATE_CLIENT_BURST=100
# Shared anonymous requests per second. The paired burst is 20 in code. Default 50.
# RATE_ANON_RPS=50
# Concurrent requests for one user. Default 8.
# USER_MAX_INFLIGHT=8
# Connections in the shared Redis pool. Default 64.
# REDIS_MAX_CONNECTIONS=64

# The process does not read this value. Default 200.
# STATE_COMPACT_EVERY=200
# Age before GC deletes an incomplete build. 1h, 30m, 45s, or seconds. Default 1h.
# GC_INCOMPLETE_AGE=1h
# Cron for that GC. Default 03:00.
# GC_CRON="0 3 * * *"
# Extra attempts after a builder or embed/rerank failure. Default 2.
# RETRY_MAX=2
# Queued tasks one user may hold on one queue. Default 20.
# USER_MAX_QUEUED=20
# Milliseconds before another worker may reclaim a task. Default 60000.
# TASKIQ_IDLE_TIMEOUT_MS=60000
# Seconds between lease extensions for a live task. Default 15.
# TASKIQ_LEASE_REFRESH_SEC=15
# Seconds between scans for abandoned tasks. Default 10.
# TASKIQ_RECLAIM_INTERVAL_SEC=10
# Seconds one worker holds the reclaim lock. Default 30.
# TASKIQ_RECLAIM_LOCK_SEC=30
# Approximate cap on a queue stream. Default 100000.
# TASKIQ_STREAM_MAXLEN=100000
# Seconds between operation heartbeats. Default 15.
# OP_HEARTBEAT_SEC=15
# Seconds without a fresh heartbeat before reconcile closes the operation. Default 120.
# OP_STALE_SEC=120
# Attempts before a task goes to the dead-letter stream. Default 2.
# TASK_RETRY_MAX=2
# Base delay for a task retry, seconds. Default 5.
# TASK_RETRY_BASE_SEC=5
# Cap on that delay, seconds. Default 300.
# TASK_RETRY_MAX_DELAY_SEC=300
# Kill an isolated heavy stage after this many seconds. Default 1800.
# HEAVY_STAGE_TIMEOUT_SEC=1800
# Seconds the heavy stage gets after the timeout signal. Default 5.
# HEAVY_STAGE_KILL_GRACE_SEC=5
# Memory cap of that stage, megabytes. Default 4096.
# HEAVY_STAGE_MEMORY_MB=4096
# The process does not read this value. Default 200000.
# ISOLATE_PROJECTION_MIN_ROWS=200000
# Failures before the builder or a model circuit opens. Default 5.
# CB_FAILURES=5
# Seconds that circuit stays open. Default 30.
# CB_OPEN_SEC=30
# Seconds an embedded child may take to exit. Default 25.
# SHUTDOWN_GRACE_SEC=25

# Books in a cluster before it becomes a proposal, unless a row is critical. Default 3.
# PROPOSE_MIN_BOOKS=3
# The process does not read this value. Default 0.05.
# UNKNOWN_MATERIAL_SHARE=0.05
# Cron for unmapped clustering, queue fas:batch. Default 04:00.
# UNMAPPED_CLUSTER_CRON="0 4 * * *"
# HDBSCAN min cluster size when embeddings exist. Default 2.
# UNMAPPED_MIN_CLUSTER=2
# Cron for glossary mining, queue fas:batch. Default 04:30.
# GLOSSARY_MINE_CRON="30 4 * * *"
# Cron for learning compaction, queue fas:maintenance. Default 02:00.
# COMPACT_CRON="0 2 * * *"
# true may write mined labels when no canary is active. Default false.
# GLOSSARY_AUTO_PROMOTE=false
# Books a mined label must be seen in. Default 3.
# GLOSSARY_AUTO_MIN_BOOKS=3
# Confirmations a mined label must have. Default 2.
# GLOSSARY_AUTO_MIN_CONFIRMATIONS=2
# The process does not read this value. Default 0.98.
# GLOSSARY_AUTO_PRECISION_GATE=0.98
# Recent glossary jobs included in a shadow report. Default 50.
# GLOSSARY_SHADOW_RECENT_BOOKS=50
# Percent of books that read a canary release. 0 to 100. Default 10.
# GLOSSARY_CANARY_SHARE=10
# Hours before a canary may promote. Default 48.
# GLOSSARY_CANARY_HOURS=48
# Books required before that promotion. Default 10.
# GLOSSARY_CANARY_MIN_BOOKS=10
# Coverage rows required before that promotion. Default 200.
# GLOSSARY_CANARY_MIN_ROWS=200
# Hours after which a quiet canary still promotes. Default 168.
# GLOSSARY_CANARY_MAX_HOURS=168
# Books handled in one remap batch. Default 20.
# REMAP_BATCH_BOOKS=20
# Remap pace. The pause between batches is batch / this value, in minutes. Default 60.
# REMAP_BOOKS_PER_MIN=60
# New positive human signals before the calibrator trains again. Default 500.
# RECALIBRATE_EVERY=500
# max_risk passed into calibrator training. Default 0.02.
# CALIBRATOR_MAX_RISK=0.02
