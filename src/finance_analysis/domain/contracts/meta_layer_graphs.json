{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fas.local/contracts/meta_layer_graphs.json",
  "title": "MetaLayerGraphs",
  "description": "Фаза 4 метаслоя (G2): стабильные id рёбер трёх графов и ответ трассировки. Три графа не схлопываются в один датасет.",
  "type": "object",
  "$defs": {
    "edgeId": {
      "type": "string",
      "minLength": 1,
      "description": "Префикс пространства: excel: | sem: | metric:"
    },
    "excelEdgeId": {
      "type": "string",
      "pattern": "^excel:link:[0-9a-f]{16}$",
      "description": "Физическое ребро graph_links: sha1(model_id|build_key|cell|ref_cell)[:16]"
    },
    "semBindEdgeId": {
      "type": "string",
      "pattern": "^sem:bind:[0-9a-f]{16}$",
      "description": "Семантическое ребро привязки: sha1(model_id|build_key|binding_key)[:16]"
    },
    "semRelEdgeId": {
      "type": "string",
      "pattern": "^sem:rel:(composed_of|broader_than|related_to):.+->.+$",
      "description": "Ребро таксономии; не вход метрики и не строка graph_links"
    },
    "metricInEdgeId": {
      "type": "string",
      "pattern": "^metric:in:[^:]+:(all_of|one_of):.+$",
      "description": "Формульное ребро показателя → concept из каталога"
    },
    "missingTrace": {
      "type": ["string", "null"],
      "enum": ["metric_unknown", "no_primary_binding", "no_cell", null],
      "description": "Явная причина отсутствия физического следа; null если cell_ids непусты"
    },
    "excelLink": {
      "type": "object",
      "required": ["edge_id", "cell", "ref_cell"],
      "additionalProperties": false,
      "properties": {
        "edge_id": { "$ref": "#/$defs/excelEdgeId" },
        "cell": { "type": ["string", "null"] },
        "ref_cell": { "type": ["string", "null"] },
        "formula_class": { "type": ["string", "null"] },
        "truncated": { "type": "boolean" }
      }
    },
    "traceStep": {
      "type": "object",
      "required": [
        "concept",
        "role",
        "metric_edge_id",
        "binding_key",
        "binding_edge_id",
        "row_key",
        "cell_ids",
        "missing_trace",
        "excel_links"
      ],
      "additionalProperties": false,
      "properties": {
        "concept": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["all_of", "one_of"] },
        "metric_edge_id": { "$ref": "#/$defs/metricInEdgeId" },
        "binding_key": { "type": ["string", "null"] },
        "binding_edge_id": {
          "anyOf": [{ "$ref": "#/$defs/semBindEdgeId" }, { "type": "null" }]
        },
        "row_key": { "type": ["string", "null"] },
        "cell_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_trace": { "$ref": "#/$defs/missingTrace" },
        "excel_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/excelLink" }
        }
      }
    },
    "metricTrace": {
      "type": "object",
      "required": ["metric_id", "variant", "build_key", "model_id", "steps", "missing_trace"],
      "additionalProperties": false,
      "description": "Read-only трассировка metric → concept → binding_key → cell_id",
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "variant": { "type": ["string", "null"] },
        "build_key": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "catalog_version": { "type": ["string", "null"] },
        "missing_trace": { "$ref": "#/$defs/missingTrace" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceStep" }
        }
      }
    },
    "graphNamespaces": {
      "type": "object",
      "description": "Три непересекающихся пространства id; graph_links только excel:",
      "additionalProperties": false,
      "required": ["physical", "semantic", "metric"],
      "properties": {
        "physical": {
          "type": "object",
          "required": ["prefix", "dataset", "node", "edge"],
          "additionalProperties": false,
          "properties": {
            "prefix": { "const": "excel:" },
            "dataset": { "const": "graph_links" },
            "node": { "const": "cell_id" },
            "edge": { "const": "excel:link:{digest16}" }
          }
        },
        "semantic": {
          "type": "object",
          "required": ["prefix", "datasets", "nodes", "edges"],
          "additionalProperties": false,
          "properties": {
            "prefix": { "const": "sem:" },
            "datasets": {
              "type": "array",
              "items": { "type": "string" },
              "const": ["bindings", "configs/concepts"]
            },
            "nodes": {
              "type": "array",
              "items": { "type": "string" },
              "const": ["binding_key", "concept"]
            },
            "edges": {
              "type": "array",
              "items": { "type": "string" },
              "const": ["sem:bind:{digest16}", "sem:rel:{type}:{source}->{target}"]
            }
          }
        },
        "metric": {
          "type": "object",
          "required": ["prefix", "source", "nodes", "edge"],
          "additionalProperties": false,
          "properties": {
            "prefix": { "const": "metric:" },
            "source": { "const": "financial_model_catalog" },
            "nodes": {
              "type": "array",
              "items": { "type": "string" },
              "const": ["metric_id", "concept"]
            },
            "edge": { "const": "metric:in:{metric}:{role}:{concept}" }
          }
        }
      }
    }
  }
}
